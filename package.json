{
  "name": "vyrenzo-proj1-fincore",
  "version": "1.0.0",
  "description": "Vyrenzo Bank is a next-generation banking intelligence platform designed to automate the extraction, analysis, and reconciliation of complex banking data. It leverages **Gemini 2.5 Flash Lite** for intelligent OCR and classification, a modular **Python Computation Engine** for financial accuracy, and a modern **Next.js 16** frontend for a premium user experience.",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -n \"next,fast\" -c \"cyan,green\" \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && uvicorn app.main:app --reload --reload-delay 1 --reload-exclude tests --port 8000 --host 0.0.0.0",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vyrenzo/vyrenzo-proj1-fincore.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/vyrenzo/vyrenzo-proj1-fincore/issues"
  },
  "homepage": "https://github.com/vyrenzo/vyrenzo-proj1-fincore#readme",
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "@prisma/config": "^7.6.0",
    "anthropic": "^0.0.0",
    "dotenv": "^17.4.0",
    "pg": "^8.20.0",
    "prisma": "^7.6.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
