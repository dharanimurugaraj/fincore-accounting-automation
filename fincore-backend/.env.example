# FinCore Backend — Environment Variables
# Copy this to .env and fill in real values

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://fincore:fincore_dev@localhost:5432/fincore_dev

# ── Storage ───────────────────────────────────────────────────────────────────
USE_LOCAL_STORAGE=true
LOCAL_STORAGE_PATH=./storage/data
# S3_BUCKET=
# S3_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── AI / LLM ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=REPLACE_ME
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# ── Firebase ──────────────────────────────────────────────────────────────────
# FIREBASE_PROJECT_ID=
# FIREBASE_SERVICE_ACCOUNT=

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Forex ─────────────────────────────────────────────────────────────────────
USE_RATE_FIXTURES=true

# ── Notification ──────────────────────────────────────────────────────────────
# RESEND_API_KEY=

# ── Database Admin (for init_db.py) ───────────────────────────────────────────
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=
